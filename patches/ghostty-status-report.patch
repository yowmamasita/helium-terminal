+
+    /// OSC 7501 (Program Status Protocol). Answer the support query so programs that ask first start
+    /// reporting, and pass the root record's state (a report without an `id`) to the apprt. Records
+    /// with an id describe subtasks; the app only shows what the program as a whole is doing.
+    fn programStatus(self: *StreamHandler, cmd: terminal.osc.Command.ProgramStatus) void {
+        switch (cmd) {
+            .query => |terminator| switch (terminator) {
+                inline else => |t| self.messageWriter(.{ .write_stable = "\x1b]7501;" ++
+                    terminal.osc.program_status.query_reply ++ comptime t.string() }),
+            },
+            .report => |report| if (report.readOption(.id) == null) {
+                self.surfaceMessageWriter(.{ .program_status = .{ .state = report.state } });
+            },
+        }
+    }
 };
 
