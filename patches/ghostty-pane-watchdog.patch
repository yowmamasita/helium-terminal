-        pub fn push(self: *Self, io: std.Io, value: T, timeout: Timeout) Size {
+        pub fn push(self: *Self, io: std.Io, value: T, requested: Timeout) Size {
+            // helium-terminal: the main thread never waits forever on a full queue. One stuck consumer
+            // (a pane's renderer or IO thread) would otherwise freeze every tab; the message is dropped.
+            const timeout: Timeout = if (requested == .forever and onMainThread())
+                .{ .ns = main_thread_timeout_ns }
+            else
+                requested;
+
             self.mutex.lockUncancelable(io);
