+const main_thread_timeout_ns = 250 * std.time.ns_per_ms;
+
+extern "c" fn pthread_main_np() c_int;
+
+fn onMainThread() bool {
+    if (comptime !builtin.os.tag.isDarwin()) return false;
+    return pthread_main_np() == 1;
