+/// Sends a ping and returns whether the previous one was answered.
+/// Never blocks, so the app can call it on a thread that might be stuck. Call from one thread only.
+pub fn ping(self: *Thread) bool {
+    const sent = self.ping_sent.load(.monotonic);
+    const answered = self.ping_seen.load(.acquire) == sent;
+    self.ping_sent.store(sent + 1, .release);
+    self.ping_h.notify() catch {};
+    return answered;
+}
+
+/// Test hook: blocks this thread forever on its next ping, like a renderer stuck in a system call.
+pub fn debugHang(self: *Thread) void {
+    self.debug_hang.store(true, .release);
+    self.ping_h.notify() catch {};
+}
+
+fn pingCallback(
+    self_: ?*Thread,
+    _: *xev.Loop,
+    _: *xev.Completion,
+    r: xev.Async.WaitError!void,
+) xev.CallbackAction {
+    _ = r catch return .rearm;
+    const t = self_.?;
+    while (t.debug_hang.load(.acquire)) std.Io.sleep(global.io(), .fromSeconds(1), .awake) catch {};
+    t.ping_seen.store(t.ping_sent.load(.acquire), .release);
+    return .rearm;
+}
