+test "forever push preserves final update after wake without capacity" {
+    const testing = std.testing;
+    const io = testing.io;
+    const Q = BlockingQueue(u64, 1);
+    var q: Q = .{};
+    try testing.expectEqual(@as(Q.Size, 1), q.push(io, 1, .instant));
+    const Producer = struct {
+        fn run(queue: *Q, result: *Q.Size) void {
+            result.* = queue.push(std.testing.io, 99, .forever);
+        }
+    };
+    var result: Q.Size = 0;
+    const producer = try std.Thread.spawn(.{}, Producer.run, .{ &q, &result });
+    defer producer.join();
+    // Always release the producer, including when an assertion fails.
+    defer _ = q.pop(io);
+    while (true) {
+        q.mutex.lockUncancelable(io);
+        if (q.not_full_waiters != 0) break;
+        q.mutex.unlock(io);
+        std.Thread.yield() catch {};
+    }
+    // Notify without freeing a slot, just as when another producer wins it.
+    q.cond_not_full.signal(io);
+    q.mutex.unlock(io);
+    while (true) {
+        q.mutex.lockUncancelable(io);
+        const consumed = q.cond_not_full.state.load(.acquire).signals == 0;
+        const waiting = q.not_full_waiters != 0;
+        q.mutex.unlock(io);
+        if (consumed) {
+            try testing.expect(waiting);
+            break;
+        }
+        std.Thread.yield() catch {};
+    }
+    try testing.expectEqual(@as(?u64, 1), q.pop(io));
+    // Joining before inspecting verifies the final update was really queued.
+    // A separate scope is needed since the deferred join runs on return.
+    while (true) {
+        q.mutex.lockUncancelable(io);
+        const ready = q.len != 0;
+        q.mutex.unlock(io);
+        if (ready) break;
+        std.Thread.yield() catch {};
+    }
+    try testing.expectEqual(@as(?u64, 99), q.pop(io));
+}
+
